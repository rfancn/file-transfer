{
  "Statement": [
    {
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::*"
      ]
    },
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPolicy",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketTagging",
        "s3:GetBucketAcl"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringEquals": {
          "s3:delimiter": "/"
        },
        "StringLikeIfExists": {
          "s3:prefix": [
            "",
            "*/",
            "*/inbound/",
            "*/inbound/*",
            "*/outbound/",
            "*/outbound/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "*/inbound/",
            "*/inbound/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "*/upload/",
            "*/upload/*"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "Null": {
          "s3:delimiter": "true"
        },
        "StringNotLike": {
          "s3:prefix": [
            "*/inbound/",
            "*/inbound/*"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/.keep"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/outbound/*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
