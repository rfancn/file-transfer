{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "",
            "*/",
            "*/inbound/",
            "*/inbound/*",
            "*/outbound/",
            "*/outbound/*",
            "*/upload/",
            "*/upload/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/*"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/upload/*"
      ]
    },
    {
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/outbound/*"
      ]
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/.keep"
      ]
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/outbound/.keep"
      ]
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/upload/.keep"
      ]
    },
    {
      "Action": [
        "s3:HeadBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    }
  ],
  "Version": "2012-10-17"
}
