{
  "Statement": [
    {
      "Action": [
        "admin:CreateUser",
        "admin:DeleteUser",
        "admin:GetUser",
        "admin:ListUsers",
        "admin:AddUserToGroup",
        "admin:RemoveUserFromGroup",
        "admin:CreatePolicy",
        "admin:DeletePolicy",
        "admin:AttachUserOrGroupPolicy",
        "admin:ListUserPolicies",
        "admin:GetGroup",
        "admin:ListGroups"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::*"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListBucketMultipartUploads"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Action": [
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/outbound/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/upload/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/inbound/"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/outbound/"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/*/upload/"
      ]
    }
  ],
  "Version": "2012-10-17"
}
