{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "{{user}}/",
            "{{user}}/*",
            "{{user}}/inbound/",
            "{{user}}/inbound/*",
            "{{user}}/outbound/",
            "{{user}}/outbound/*",
            "{{user}}/upload/",
            "{{user}}/upload/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{bucket}}"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{bucket}}/{{user}}/inbound/*"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{bucket}}/{{user}}/upload/*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
