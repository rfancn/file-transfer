{
  "Statement": [
    {
      "Sid": "HomeBucketMetadata",
      "Action": [
        "s3:HeadBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Sid": "ListOwnDirs",
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${aws:username}",
            "${aws:username}/",
            "${aws:username}/inbound",
            "${aws:username}/inbound/",
            "${aws:username}/inbound/*",
            "${aws:username}/outbound",
            "${aws:username}/outbound/",
            "${aws:username}/outbound/*",
            "${aws:username}/upload",
            "${aws:username}/upload/",
            "${aws:username}/upload/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}"
      ]
    },
    {
      "Sid": "UploadWrite",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/${aws:username}/upload/*"
      ]
    },
    {
      "Sid": "UploadMarkerProtect",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::{{HOME_BUCKET}}/${aws:username}/upload/.keep",
        "arn:aws:s3:::{{HOME_BUCKET}}/${aws:username}/upload/"
      ]
    },
    {
      "Sid": "SharedBucketMetadata",
      "Action": [
        "s3:HeadBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{SHARED_BUCKET}}"
      ]
    },
    {
      "Sid": "SharedRootList",
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringEquals": {
          "s3:delimiter": "/"
        },
        "StringLikeIfExists": {
          "s3:prefix": [
            "",
            "{{SHARED_DIR_PREFIXES}}"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{SHARED_BUCKET}}"
      ]
    },
    {
      "Sid": "SharedDirList",
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "{{SHARED_DIR_PREFIXES}}"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::{{SHARED_BUCKET}}"
      ]
    },
    {
      "Sid": "SharedRead",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "{{SHARED_DIR_OBJECT_ARNS}}"
      ]
    }
  ],
  "Version": "2012-10-17"
}