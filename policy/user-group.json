{
  "Statement": [
    {
      "Action": [
        "s3:HeadBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::file-transfer"
      ]
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${aws:username}/upload",
            "${aws:username}/upload/",
            "${aws:username}/upload/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::file-transfer"
      ]
    },
    {
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::file-transfer/${aws:username}/upload/*"
      ]
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectTagging"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::file-transfer/${aws:username}/upload/*"
      ]
    }
  ],
  "Version": "2012-10-17"
}